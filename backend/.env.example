# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Supabase (Optional - works with mock data without these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret
JWT_SECRET=agranex-super-secret-key-2026

# NVIDIA NIM API (Optional - uses fallback models without this)
NVIDIA_NIM_API_KEY=your-nvidia-nim-key

# Satellite APIs (Optional - uses mock data without these)
SENTINEL_HUB_API_KEY=your-sentinel-hub-key
NASA_API_KEY=your-nasa-api-key

# Google Earth Engine (Optional)
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
